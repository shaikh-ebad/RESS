<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#190019">

    <!-- ================= HEADER ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESS"
            android:textColor="#FBE4D8"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect Beyond Limits"
            android:textColor="#DFB6B2"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline • Secure • Decentralized"
            android:textColor="#854F6C"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <!-- ================= MAIN CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- CONNECTION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="#2B124C">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your ID: PHONE_XXX&#10;Not connected"
                    android:textColor="#FBE4D8"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="CONNECT TO MESH"
                    android:textColor="#190019"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#DFB6B2" />

            </LinearLayout>

            <!-- DISCOVER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:background="#2B124C">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discover Phones"
                    android:textColor="#FBE4D8"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find phones currently available on the mesh network."
                    android:textColor="#DFB6B2"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp" />

                <Button
                    android:id="@+id/discoverVisibleButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="DISCOVER PHONES"
                    android:textColor="#190019"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#DFB6B2" />

            </LinearLayout>

            <!-- AVAILABLE PHONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Phones"
                android:textColor="#FBE4D8"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/discoverableListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2B124C" />

            <!-- PREVIOUS CHATS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Previous Chats"
                android:textColor="#FBE4D8"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/oldChatsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2B124C" />

        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM NAVIGATION ================= -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2B124C">

        <Button
            android:id="@+id/chatsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Chats"
            android:textColor="#FBE4D8"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/aiButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AI Assistant"
            android:textColor="#FBE4D8"
            android:textStyle="bold"
            android:background="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>
