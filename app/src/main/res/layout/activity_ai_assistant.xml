<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#190019">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp"
        android:background="#2B124C">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESS"
            android:textColor="#FBE4D8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Offline AI Assistant"
            android:textColor="#DFB6B2"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Private • Local • No Internet Required"
            android:textColor="#B88FA5"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- AI STATUS BAR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#190019">

        <TextView
            android:id="@+id/aiStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Status: Initializing..."
            android:textSize="13sp"
            android:textColor="#DFB6B2" />

        <Button
            android:id="@+id/clearAIHistoryButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Clear"
            android:textSize="11sp"
            android:textColor="#FBE4D8"
            android:textAllCaps="false"
            android:backgroundTint="#522B5B"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/backToChatButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Back"
            android:textSize="11sp"
            android:textColor="#190019"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#DFB6B2" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- AI CONVERSATION -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/aiScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="#190019">

        <LinearLayout
            android:id="@+id/aiConversationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

    </ScrollView>


    <!-- ===================================================== -->
    <!-- QUICK ACTIONS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#2B124C">

        <Button
            android:id="@+id/quickHelpButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Help"
            android:textSize="11sp"
            android:textColor="#FBE4D8"
            android:textAllCaps="false"
            android:backgroundTint="#522B5B"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/quickDraftButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Draft Message"
            android:textSize="11sp"
            android:textColor="#FBE4D8"
            android:textAllCaps="false"
            android:backgroundTint="#522B5B"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/quickCalcButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Calculate"
            android:textSize="11sp"
            android:textColor="#FBE4D8"
            android:textAllCaps="false"
            android:backgroundTint="#522B5B"
            android:layout_marginStart="4dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- INPUT AREA -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="#190019">

        <EditText
            android:id="@+id/aiInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Ask me anything..."
            android:textColor="#FBE4D8"
            android:textColorHint="#B88FA5"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="#2B124C"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3" />

        <Button
            android:id="@+id/aiSendButton"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="ASK"
            android:textColor="#190019"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#DFB6B2" />

    </LinearLayout>

</LinearLayout>